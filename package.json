{
  "name": "engineer-principles-analyzer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Analyzes subjects against engineering principles.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rcasia/engineer-principles-analyzer.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.0",
  "scripts": {
    "prepare": "lefthook install",
    "typecheck": "tsc --build",
    "test": "bun test",
    "test:mutation": "bunx stryker run",
    "check": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@stryker-mutator/core": "^10.0.0",
    "@types/bun": "^1.4.2",
    "lefthook": "^2.1.14",
    "typescript": "^5.9.0"
  }
}
